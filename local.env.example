# Copy to local.env and set the paths of your machine. tools/lacre_boot.py loads it.
# A clone of github.com/eudomar500/lacre (its tools/ and tests/ are used).
LACRE_DIR=
# A file with PRIVATE_KEY=0x... of the wallet that owns and relays the escrow and pays GEN.
SIGNER_ENV=
# A folder with guardian.env (GUARDIAN_KEY=), buyer.env (BUYER_KEY=) and merchant.env (MERCHANT_KEY=).
E2E_KEYS=
# The dist/ folder of an installed genlayer-js 2.x (used by tools/tx_votes.mjs).
GLJS_DIST=
# The store's DKIM private key (PEM), used only by tools/sign_mail.mjs.
DKIM_KEY_FILE=
